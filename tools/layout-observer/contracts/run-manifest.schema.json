{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ximicpp.github.io/TypeLayout/layout-observer/0.1/run-manifest.schema.json",
  "title": "Layout Observer run-manifest 0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workingDirectory": {
            "type": "string",
            "minLength": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "os",
              "architecture"
            ],
            "additionalProperties": false
          },
          "outputArgument": {
            "type": "string",
            "minLength": 1
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "buildSteps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "executable": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "workingDirectory": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              },
              "required": [
                "executable",
                "arguments",
                "workingDirectory",
                "timeoutSeconds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "executable",
          "arguments",
          "workingDirectory",
          "timeoutSeconds",
          "id",
          "configuration",
          "target",
          "outputArgument",
          "requiredCapabilities",
          "artifact"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "compareManifest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "compareManifest"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "profiles",
    "comparisons"
  ],
  "additionalProperties": false
}
