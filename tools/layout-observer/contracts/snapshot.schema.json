        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "unsupported"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "view": {
          "enum": [
            "native",
            "managed",
            "marshaled"
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "complete-value",
                "embedded-value",
                "array-element",
                "heap-object",
                "boxed-value"
