{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ximicpp.github.io/TypeLayout/layout-observer/0.1/snapshot.schema.json",
  "title": "Layout Observer snapshot 0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
