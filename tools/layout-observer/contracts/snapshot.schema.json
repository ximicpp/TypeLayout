          "additionalProperties": false
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "object"
        },
        "requestedProfile": {
          "type": "object"
        }
      },
      "required": [
        "buildId",
        "runId",
        "configuration",
        "sourceRevision",
        "sourceDigest",
        "artifactDigest",
        "sourceDirty",
        "compiler",
        "runtime",
        "target",
        "flags",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "typeDescriptors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeDescriptor"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "observationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
