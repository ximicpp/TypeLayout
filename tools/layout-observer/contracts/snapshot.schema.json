              "type": "string",
              "minLength": 1
            },
            "hostMemberId": {
              "type": "string",
              "minLength": 1
            },
            "elementIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "value-start",
                "object-reference",
                "instance-data",
                "anchor-field"
              ]
            },
            "extentStartBit": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "conversionEvidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "kind",
            "extentStartBit"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "valueSizeBytes": {
              "$ref": "#/$defs/sizeFact"
            },
            "standaloneSizeBytes": {
              "$ref": "#/$defs/sizeFact"
            },
            "referenceSlotBytes": {
              "$ref": "#/$defs/sizeFact"
            },
            "arrayStrideBytes": {
              "$ref": "#/$defs/sizeFact"
            },
            "runtimeReportedObjectBytes": {
              "$ref": "#/$defs/sizeFact"
            },
            "alignmentBytes": {
              "$ref": "#/$defs/sizeFact"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "runtimeRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
