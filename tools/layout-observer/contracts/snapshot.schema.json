        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "scalar",
            "enum",
            "record",
            "union",
            "array",
            "reference",
            "opaque"
          ]
        },
        "representation": {
          "type": "object",
          "properties": {
            "category": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "known"
                    },
                    "value": {
                      "enum": [
                        "integer",
                        "float",
                        "boolean",
                        "character",
                        "byte"
                      ]
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidence"
                    }
                  },
                  "required": [
                    "state",
                    "value",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "unknown",
                        "not-applicable"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "state",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "signedness": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "known"
                    },
                    "value": {
                      "enum": [
                        "signed",
                        "unsigned",
                        "not-applicable"
                      ]
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidence"
                    }
                  },
                  "required": [
                    "state",
                    "value",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "unknown",
                        "not-applicable"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "state",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "encoding": {
              "$ref": "#/$defs/stringFact"
            },
            "floatingFormat": {
              "$ref": "#/$defs/stringFact"
            },
            "widthBits": {
              "$ref": "#/$defs/positiveFact"
            }
          },
          "required": [
            "widthBits"
          ],
          "additionalProperties": false
        },
        "enumUnderlyingTypeRef": {
          "type": "string",
          "minLength": 1
