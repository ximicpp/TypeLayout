        "elementTypeRef": {
          "type": "string",
          "minLength": 1
        },
        "fixedCount": {
          "$ref": "#/$defs/sizeFact"
        },
        "referenceKind": {
          "enum": [
            "native-pointer",
            "native-reference",
            "GC-reference",
            "function-pointer",
            "member-pointer"
          ]
        },
        "targetTypeRef": {
          "type": "string",
          "minLength": 1
        },
        "opaqueTag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "displayName",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scalar"
              }
            }
          },
          "then": {
            "required": [
              "representation"
            ],
            "properties": {
              "representation": {
                "required": [
                  "category",
                  "signedness",
                  "encoding",
                  "floatingFormat",
                  "widthBits"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "enumUnderlyingTypeRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "elementTypeRef",
              "fixedCount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "referenceKind",
              "representation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "opaque"
              }
            }
          },
          "then": {
            "required": [
              "opaqueTag"
            ]
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "declarationOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "role": {
          "enum": [
            "field",
            "base"
          ]
        },
        "typeRef": {
          "type": "string",
          "minLength": 1
        },
        "offsetBits": {
          "$ref": "#/$defs/integerFact"
        },
        "bitWidth": {
          "$ref": "#/$defs/sizeFact"
        },
        "declaredTypeSizeBits": {
          "$ref": "#/$defs/sizeFact"
        },
        "occupiedRanges": {
          "$ref": "#/$defs/rangeFact"
        },
        "overlapGroup": {
          "type": "string",
          "minLength": 1
        },
        "childObservationId": {
          "type": "string",
          "minLength": 1
        }
