        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "method",
        "version",
        "inputs"
      ],
      "additionalProperties": false
    },
    "integerFact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "state",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sizeFact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "state",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "positiveFact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "state",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stringFact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "state",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rangeFact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startBit": {
                    "type": "integer",
                    "minimum": -9223372036854775808,
                    "maximum": 9223372036854775807
