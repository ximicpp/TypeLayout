                "$ref": "#/$defs/rangeFact"
              }
            },
            "required": [
              "role",
              "ranges"
            ],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "fieldEnumeration": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not-applicable"
              ]
            },
            "extent": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not-applicable"
              ]
            },
            "occupiedRanges": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not-applicable"
              ]
            },
            "hiddenRegions": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not-applicable"
              ]
            }
          },
          "required": [
            "fieldEnumeration",
            "extent",
            "occupiedRanges",
            "hiddenRegions"
          ],
          "additionalProperties": false
        },
        "instanceShape": {
          "type": "object",
