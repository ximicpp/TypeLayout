    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "version",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "type": "string",
          "minLength": 1
        },
        "sourceDirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "compiler": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            },
            "abi": {
              "type": "string",
              "minLength": 1
            },
            "pointerBits": {
              "enum": [
                32,
                64
              ]
            },
            "bitsPerByte": {
              "const": 8
            },
            "endian": {
              "enum": [
                "little",
                "big"
              ]
            }
          },
          "required": [
            "os",
            "architecture",
            "abi",
            "pointerBits",
            "bitsPerByte",
            "endian"
