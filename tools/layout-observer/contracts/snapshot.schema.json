              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            }
          },
          "required": [
            "length",
            "dimensions"
          ],
          "additionalProperties": false
        },
        "marshallingProfile": {
