              "minLength": 1
            },
            "configuration": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "mechanism",
            "configuration"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "typeId",
        "displayName",
        "status",
        "limitations",
        "view",
        "context",
        "origin",
        "metrics",
        "members",
        "runtimeRegions",
        "coverage"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "const": "marshaled"
              }
