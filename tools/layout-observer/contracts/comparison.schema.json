                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "version"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "os": {
                      "type": "string",
                      "minLength": 1
                    },
                    "architecture": {
                      "type": "string",
                      "minLength": 1
                    },
                    "abi": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pointerBits": {
                      "enum": [
                        32,
                        64
                      ]
                    },
                    "bitsPerByte": {
                      "const": 8
                    },
                    "endian": {
                      "enum": [
                        "little",
                        "big"
                      ]
                    }
                  },
                  "required": [
                    "os",
                    "architecture",
                    "abi",
                    "pointerBits",
                    "bitsPerByte",
                    "endian"
                  ],
                  "additionalProperties": false
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "dependencies": {
                  "type": "object"
                },
                "requestedProfile": {
                  "type": "object"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "collectorProvenance": {
                  "type": "object"
                },
                "captureProvenance": {
                  "type": "object",
                  "properties": {
                    "sourceBinding": {
                      "enum": [
                        "profile",
                        "run-default"
                      ]
                    },
                    "sourceDigestScope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifactVerifiedStable": {
                      "type": "boolean"
                    },
                    "sourceRelation": {
                      "enum": [
                        "built-in-run",
                        "unverified"
                      ]
                    }
                  },
                  "required": [
                    "sourceBinding",
                    "sourceDigestScope",
                    "artifactVerifiedStable",
                    "sourceRelation"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "buildId",
                "runId",
                "configuration",
                "sourceRevision",
                "sourceDigest",
                "artifactDigest",
                "sourceDirty",
                "compiler",
                "runtime",
                "target",
                "flags",
                "dependencies"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "snapshotId",
            "build"
          ],
          "additionalProperties": false
        },
        "right": {
          "type": "object",
          "properties": {
            "snapshotId": {
              "type": "string",
              "minLength": 1
            },
            "build": {
              "type": "object",
              "properties": {
                "buildId": {
                  "type": "string",
                  "minLength": 1
