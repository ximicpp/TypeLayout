                      ]
                    },
                    "sourceDigestScope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifactVerifiedStable": {
                      "type": "boolean"
                    },
                    "sourceRelation": {
                      "enum": [
                        "built-in-run",
