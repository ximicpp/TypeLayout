{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ximicpp.github.io/TypeLayout/layout-observer/0.1/project-result.schema.json",
  "title": "Layout Compare project-result 0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "snapshotId": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "required": [
                "snapshotId",
                "snapshot"
              ]
            },
            "else": {
              "required": [
                "error"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "exitCode": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "diff": {
            "type": "string",
            "minLength": 1
          },
          "html": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "required": [
                "exitCode",
                "diff",
                "html"
              ]
            },
            "else": {
              "required": [
                "error"
              ]
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "exitCode",
    "variants",
    "comparisons"
  ],
  "additionalProperties": false
}
