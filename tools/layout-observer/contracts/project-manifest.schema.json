{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ximicpp.github.io/TypeLayout/layout-observer/0.1/project-manifest.schema.json",
  "title": "Layout Compare project-manifest 0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "mapping": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "snapshot",
          "mapping"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/logicalField"
                  }
                }
              },
              "required": [
                "id",
                "observation",
                "fields"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "cases"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "regression",
              "representation",
              "marshaled-layout"
            ]
          },
          "scope": {
            "enum": [
              "value",
              "array",
              "object"
            ]
          },
          "policy": {
            "enum": [
              "value-fields-v1",
              "value-alignment-v1"
            ]
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "mode",
          "scope",
          "policy",
          "cases"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "variants",
    "mappings",
    "comparisons"
  ],
  "additionalProperties": false,
  "$defs": {
    "logicalField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logicalField"
          }
        }
      },
      "required": [
        "id",
        "member"
      ],
      "additionalProperties": false
    }
  }
}
