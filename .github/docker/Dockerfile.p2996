# syntax=docker.io/docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Native Bloomberg P2996 Clang image. The compiler and its libc++ runtime are
# built together from one immutable LLVM commit on the target architecture.
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
FROM ${DEBIAN_IMAGE} AS builder

ARG BUILDARCH
ARG TARGETARCH
ARG DEBIAN_SNAPSHOT=https://snapshot.debian.org/archive/debian/20260824T000000Z/
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    case "$(uname -m)" in \
        x86_64) native_arch=amd64 ;; \
        aarch64|arm64) native_arch=arm64 ;; \
        *) echo "unsupported native architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    test -n "${BUILDARCH}"; \
    test -n "${TARGETARCH}"; \
    test "${BUILDARCH}" = "${TARGETARCH}"; \
    test "${BUILDARCH}" = "${native_arch}"

RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) ninja_package='ninja-build:amd64=1.12.1-1' ;; \
        arm64) ninja_package='ninja-build:arm64=1.12.1-1+b1' ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    bootstrap_snapshot="http://${DEBIAN_SNAPSHOT#https://}"; \
    printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] %s trixie main\n' "${bootstrap_snapshot}" \
        > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
        ca-certificates=20250419; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] %s trixie main\n' "${DEBIAN_SNAPSHOT}" \
        > /etc/apt/sources.list; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
        build-essential=12.12 \
        ca-certificates=20250419 \
        cmake=3.31.6-2 \
        curl=8.14.1-2+deb13u4 \
        git=1:2.47.3-0+deb13u1 \
        libncurses-dev=6.5+20250216-2 \
        libxml2-dev=2.12.7+dfsg+really2.9.14-2.1+deb13u3 \
        libzstd-dev=1.5.7+dfsg-1 \
        "${ninja_package}" \
        python3=3.13.5-1 \
        tar=1.35+dfsg-3.1 \
        zlib1g-dev=1:1.3.dfsg+really1.3.1-1+b1 \
        zstd=1.5.7+dfsg-1; \
    rm -rf /var/lib/apt/lists/*

ARG P2996_REPOSITORY=https://github.com/bloomberg/clang-p2996.git
ARG P2996_COMMIT=060be17654102019e14810c3f948ef85a490755f
WORKDIR /opt/llvm-p2996
RUN git init . \
    && git remote add origin "${P2996_REPOSITORY}" \
    && git fetch --depth=1 origin "${P2996_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${P2996_COMMIT}"

RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) llvm_target=X86 ;; \
        arm64) llvm_target=AArch64 ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cmake -S llvm -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/p2996-toolchain \
        -DLLVM_ENABLE_PROJECTS="clang" \
        -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" \
        -DLLVM_TARGETS_TO_BUILD="${llvm_target}" \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DCLANG_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_DOCS=OFF \
        -DCLANG_BUILD_EXAMPLES=OFF \
        -DCLANG_DEFAULT_CXX_STDLIB=libc++ \
        -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
        -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
        -DLLVM_PARALLEL_LINK_JOBS=1

# Bound compiler concurrency to one job per 2 GiB of available memory.
RUN set -eu; \
    threads="$(nproc)"; \
    available="$(awk '/MemAvailable:/ { printf "%.0f\n", $2 * 1024 }' /proc/meminfo)"; \
    if [ -r /sys/fs/cgroup/memory.max ]; then \
        limit="$(cat /sys/fs/cgroup/memory.max)"; \
        if [ "${limit}" != max ] && [ "${limit}" -lt "${available}" ]; then \
            available="${limit}"; \
        fi; \
    fi; \
    memory_jobs="$(( available / 2147483648 ))"; \
    [ "${memory_jobs}" -ge 1 ] || memory_jobs=1; \
    jobs="${threads}"; \
    [ "${jobs}" -le "${memory_jobs}" ] || jobs="${memory_jobs}"; \
    cmake --build build --parallel "${jobs}"; \
    cmake --install build --strip; \
    test -x /opt/p2996-toolchain/bin/clang; \
    test -x /opt/p2996-toolchain/bin/clang++; \
    test -f /opt/p2996-toolchain/include/c++/v1/vector; \
    runtime_triple="$(/opt/p2996-toolchain/bin/clang++ -dumpmachine)"; \
    target_include_dir="/opt/p2996-toolchain/include/${runtime_triple}/c++/v1"; \
    test -f "${target_include_dir}/__config_site"; \
    runtime_dir="/opt/p2996-toolchain/lib/${runtime_triple}"; \
    test -d "${runtime_dir}"; \
    for runtime_pattern in 'libc++.*' 'libc++abi.*' 'libunwind.*'; do \
        runtime_match="$(find "${runtime_dir}" \
            -name "${runtime_pattern}" -print -quit)"; \
        test -n "${runtime_match}"; \
    done

FROM ${DEBIAN_IMAGE} AS runtime

ARG BUILDARCH
ARG TARGETARCH
ARG DEBIAN_SNAPSHOT=https://snapshot.debian.org/archive/debian/20260824T000000Z/
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    case "$(uname -m)" in \
        x86_64) native_arch=amd64 ;; \
        aarch64|arm64) native_arch=arm64 ;; \
        *) echo "unsupported native architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    test -n "${BUILDARCH}"; \
    test -n "${TARGETARCH}"; \
    test "${BUILDARCH}" = "${TARGETARCH}"; \
    test "${BUILDARCH}" = "${native_arch}"

RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) ninja_package='ninja-build:amd64=1.12.1-1' ;; \
        arm64) ninja_package='ninja-build:arm64=1.12.1-1+b1' ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    bootstrap_snapshot="http://${DEBIAN_SNAPSHOT#https://}"; \
    printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] %s trixie main\n' "${bootstrap_snapshot}" \
        > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
        ca-certificates=20250419; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] %s trixie main\n' "${DEBIAN_SNAPSHOT}" \
        > /etc/apt/sources.list; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
        binutils=2.44-3 \
        ca-certificates=20250419 \
        cmake=3.31.6-2 \
        git=1:2.47.3-0+deb13u1 \
        libc6-dev=2.41-12+deb13u3 \
        libgcc-14-dev=14.2.0-19 \
        libtinfo6=6.5+20250216-2 \
        libxml2=2.12.7+dfsg+really2.9.14-2.1+deb13u3 \
        libzstd1=1.5.7+dfsg-1 \
        "${ninja_package}" \
        python3=3.13.5-1 \
        zlib1g=1:1.3.dfsg+really1.3.1-1+b1 \
        zstd=1.5.7+dfsg-1; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/p2996-toolchain /opt/p2996-toolchain

ENV PATH=/opt/p2996-toolchain/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/p2996-toolchain/lib/x86_64-unknown-linux-gnu:/opt/p2996-toolchain/lib/aarch64-unknown-linux-gnu:/opt/p2996-toolchain/lib
ENV CC=/opt/p2996-toolchain/bin/clang
ENV CXX=/opt/p2996-toolchain/bin/clang++

RUN <<'EOF'
set -eu
test -x /opt/p2996-toolchain/bin/clang
test -x /opt/p2996-toolchain/bin/clang++
test -f /opt/p2996-toolchain/include/c++/v1/vector
clang++ --version
runtime_triple="$(clang++ -dumpmachine)"
case "${TARGETARCH}" in
    amd64) [ "${runtime_triple}" = x86_64-unknown-linux-gnu ] ;;
    arm64) [ "${runtime_triple}" = aarch64-unknown-linux-gnu ] ;;
esac
target_include_dir="/opt/p2996-toolchain/include/${runtime_triple}/c++/v1"
test -f "${target_include_dir}/__config_site"
crtbegin="$(clang++ --print-file-name=crtbeginS.o)"
test "${crtbegin}" != crtbeginS.o
test -f "${crtbegin}"
runtime_dir="/opt/p2996-toolchain/lib/${runtime_triple}"
test -d "${runtime_dir}"
cat >/tmp/toolchain-probe.cpp <<'CPP'
#include <array>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <meta>
#include <span>
#include <type_traits>

using reflected_int = [: ^^int :];
static_assert(std::is_same_v<reflected_int, int>);

__attribute__((noinline)) void* copy_distinct(
    void* destination, const void* source, std::size_t count) {
    return std::memcpy(destination, source, count);
}

int main(int argc, char**) {
    std::uint32_t source = 7;
    alignas(std::uint32_t) std::byte storage[sizeof(source)]{};
    auto* object = static_cast<std::uint32_t*>(
        copy_distinct(storage, &source, sizeof(source)));
    *object += 5;

    std::array<std::uint32_t, 3> input{11, 13, 17};
    alignas(std::uint32_t) std::byte array_storage[sizeof(input)]{};
    const std::size_t count = argc == 1 ? input.size() : 0;
    auto* values = static_cast<std::uint32_t*>(copy_distinct(
        array_storage, input.data(), count * sizeof(std::uint32_t)));
    std::span<std::uint32_t> view(values, count);
    view[1] += *object;

    alignas(std::uint32_t) std::byte relocated_storage[sizeof(input)]{};
    auto* relocated = static_cast<std::uint32_t*>(copy_distinct(
        relocated_storage, array_storage, count * sizeof(std::uint32_t)));
    return source == 7 && *object == 12 && relocated[0] == 11 &&
            relocated[1] == 25 && relocated[2] == 17 &&
            relocated + count - relocated == 3 ? 0 : 1;
}
CPP
clang++ -std=c++26 -freflection -freflection-latest -stdlib=libc++ \
    -O3 -fstrict-aliasing \
    -nostdinc++ -isystem "${target_include_dir}" \
    -isystem /opt/p2996-toolchain/include/c++/v1 \
    -L "${runtime_dir}" -Wl,-rpath,"${runtime_dir}" \
    /tmp/toolchain-probe.cpp -o /tmp/toolchain-probe
ldd /tmp/toolchain-probe >/tmp/toolchain-probe.ldd
python3 - /tmp/toolchain-probe.ldd "${runtime_dir}" <<'PY'
# BEGIN LINUX P2996 RUNTIME LOAD VALIDATOR
from pathlib import Path
import re
import sys


pattern = re.compile(r"^(libc\+\+|libc\+\+abi|libunwind)\.so(?:\.[0-9]+)*$")
runtime_dir = Path(sys.argv[2]).resolve()
observed = {name: set() for name in ("libc++", "libc++abi", "libunwind")}
for line in Path(sys.argv[1]).read_text(
    encoding="utf-8", errors="replace"
).splitlines():
    fields = line.strip().split(" => ", 1)
    if len(fields) == 2:
        library_name = fields[0].strip()
        candidate = fields[1].rsplit(" (", 1)[0].strip()
    else:
        candidate = fields[0].rsplit(" (", 1)[0].strip()
        library_name = Path(candidate).name
    match = pattern.fullmatch(library_name)
    if match and candidate != "not found":
        observed[match.group(1)].add(Path(candidate).resolve())
for name, paths in observed.items():
    if len(paths) != 1:
        raise SystemExit(
            f"runtime {name} must resolve exactly once: {sorted(map(str, paths))!r}"
        )
    path = next(iter(paths))
    try:
        path.relative_to(runtime_dir)
    except ValueError as error:
        raise SystemExit(
            f"runtime {name} escaped bundled directory: {path}"
        ) from error
    if not path.is_file():
        raise SystemExit(f"runtime {name} is not a bundled file: {path}")
# END LINUX P2996 RUNTIME LOAD VALIDATOR
PY
/tmp/toolchain-probe
EOF

WORKDIR /workspace
LABEL org.opencontainers.image.source="https://github.com/ximicpp/TypeLayout"
LABEL org.opencontainers.image.description="Native Bloomberg P2996 Clang with matching libc++ for TypeLayout"
LABEL org.opencontainers.image.licenses="BSL-1.0"
CMD ["/bin/bash"]
